<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="log_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <TextView
            style="@style/Text.Saarthi.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log a fill-up" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Speak naturally or enter the details below." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Text.Saarthi.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice log" />

            <TextView
                style="@style/Text.Saarthi.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Example: Petrol 1500 rupees, 14 litres, meter 45200." />

            <TextView
                android:id="@+id/record_button"
                style="@style/Text.Saarthi.Action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Start 6-second recording" />

            <TextView
                android:id="@+id/record_status"
                style="@style/Text.Saarthi.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Ready when you are." />

            <TextView
                android:id="@+id/record_transcript"
                style="@style/Text.Saarthi.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="OR ENTER DETAILS"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Amount paid (₹)" />

        <EditText
            android:id="@+id/amount_input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 1500"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Fuel added (litres)" />

        <EditText
            android:id="@+id/litres_input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 14.5"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Odometer (km)" />

        <EditText
            android:id="@+id/odometer_input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 45200"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/manual_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/save_manual"
            style="@style/Text.Saarthi.Action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Save fuel entry" />
    </LinearLayout>
</ScrollView>
