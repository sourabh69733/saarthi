<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ONE TAP · OFFLINE VOICE"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <TextView
            style="@style/Text.Saarthi.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Your voice,\nyour route." />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tap Speak while parked. Saarthi listens for six seconds, then requests an action on your phone." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VOICE CONTROL"
                android:textColor="#AEE4CC"
                android:textSize="12sp"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Say what you want to do."
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Open Maps · Navigate to a place · Play music"
                android:textColor="#D6EDE2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_speak"
                android:tag="speak_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_secondary"
                android:contentDescription="Speak voice command"
                android:focusable="true"
                android:gravity="center"
                android:text="●  Speak"
                android:textColor="@color/accent_dark"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_command_status"
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityLiveRegion="polite"
            android:text="Ready. Try “open Google Maps”." />

        <TextView
            android:id="@+id/home_command_transcript"
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            style="@style/Text.Saarthi.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Try saying" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="“Open Google Maps”\n“Navigate to Connaught Place”\n“Play Arijit Singh”" />

        <TextView
            style="@style/Text.Saarthi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Your words are processed on this phone. Maps or a music app may need internet access. An action request does not confirm playback or navigation started." />
    </LinearLayout>
</ScrollView>
